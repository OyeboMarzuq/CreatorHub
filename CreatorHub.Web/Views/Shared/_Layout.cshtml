@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var isGerman = currentCulture.StartsWith("de", StringComparison.OrdinalIgnoreCase);
    var htmlLanguage = isGerman ? "de" : "en";
    var themeLabel = isGerman ? "Helles Design" : "Light Mode";
    var themeAriaLabel = isGerman ? "Zum hellen Design wechseln" : "Switch to light mode";
}
<!DOCTYPE html>
<html lang="@htmlLanguage" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CreatorHub</title>

    <script>
        (function () {
            try {
                const savedTheme = localStorage.getItem("creatorhub-theme");
                const theme = savedTheme === "light" ? "light" : "dark";
                document.documentElement.setAttribute("data-theme", theme);
            } catch {
                document.documentElement.setAttribute("data-theme", "dark");
            }
        })();
    </script>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CreatorHub.Web.styles.css" asp-append-version="true" />

    <style>
        :root {
            color-scheme: dark;
            --page-bg: #101010;
            --surface-bg: #191919;
            --surface-raised: #222222;
            --text-primary: #f8fafc;
            --text-secondary: #b8b8b8;
            --border-color: #383838;
            --input-bg: #202020;
            --accent: #dc2626;
            --accent-hover: #b91c1c;
            --link-color: #f87171;
            --nav-bg: #171717;
            --footer-bg: #141414;
            --shadow-color: rgba(0, 0, 0, 0.2);
        }

        html[data-theme="light"] {
            color-scheme: light;
            --page-bg: #f5f6f8;
            --surface-bg: #ffffff;
            --surface-raised: #f0f1f4;
            --text-primary: #171717;
            --text-secondary: #5d6470;
            --border-color: #dedfe4;
            --input-bg: #ffffff;
            --accent: #dc2626;
            --accent-hover: #b91c1c;
            --link-color: #c81e1e;
            --nav-bg: #ffffff;
            --footer-bg: #ffffff;
            --shadow-color: rgba(0, 0, 0, 0.07);
        }

        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--page-bg);
            color: var(--text-primary);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

            body > header, body > footer {
                flex-shrink: 0;
            }

            body > .container {
                flex: 1;
            }

        main {
            color: var(--text-primary);
        }

        a {
            color: var(--link-color);
        }

            a:hover {
                color: var(--accent-hover);
            }

        .navbar {
            background: var(--nav-bg) !important;
            border-color: var(--border-color) !important;
        }

            .navbar-brand, .navbar .nav-link {
                color: var(--text-primary) !important;
            }

                .navbar .nav-link:hover, .navbar-brand:hover {
                    color: var(--link-color) !important;
                }

        .navbar-toggler {
            border-color: var(--border-color);
        }

        .navbar-toggler-icon {
            filter: invert(var(--icon-invert, 1));
        }

        html[data-theme="light"] {
            --icon-invert: 0;
        }

        html[data-theme="dark"] {
            --icon-invert: 1;
        }

        .theme-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-left: 12px;
            padding: 9px 14px;
            border: 1px solid var(--border-color);
            border-radius: 999px;
            background: var(--surface-raised);
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease;
        }

            .theme-toggle:hover {
                background: var(--surface-bg);
                transform: translateY(-1px);
            }

            .theme-toggle:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 3px;
            }

        .card, .modal-content, .dropdown-menu, .list-group-item {
            background-color: var(--surface-bg);
            color: var(--text-primary);
            border-color: var(--border-color);
        }

        .dropdown-item {
            color: var(--text-primary);
        }

            .dropdown-item:hover {
                background: var(--surface-raised);
                color: var(--text-primary);
            }

        .form-control, .form-select, textarea,
        input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]),
        select {
            background-color: var(--input-bg);
            color: var(--text-primary);
            border-color: var(--border-color);
        }

            .form-control:focus, .form-select:focus, textarea:focus,
            input:focus, select:focus {
                background-color: var(--input-bg);
                color: var(--text-primary);
                border-color: var(--accent);
                box-shadow: 0 0 0 0.2rem rgba(220, 38, 38, 0.18);
            }

            .form-control::placeholder, textarea::placeholder,
            input::placeholder {
                color: var(--text-secondary);
                opacity: 0.8;
            }

        .table {
            --bs-table-color: var(--text-primary);
            --bs-table-bg: var(--surface-bg);
            --bs-table-border-color: var(--border-color);
        }

        .text-dark {
            color: var(--text-primary) !important;
        }

        .text-muted {
            color: var(--text-secondary) !important;
        }

        .bg-white {
            background-color: var(--surface-bg) !important;
        }

        .border, .border-top, .border-bottom {
            border-color: var(--border-color) !important;
        }

        .btn-danger {
            background-color: var(--accent);
            border-color: var(--accent);
        }

            .btn-danger:hover {
                background-color: var(--accent-hover);
                border-color: var(--accent-hover);
            }

        .footer {
            position: relative;
            width: 100%;
            margin-top: 32px;
            padding: 18px 0;
            background: var(--footer-bg);
            color: var(--text-secondary);
        }

        html[data-theme="light"] .voting-page {
            background: var(--page-bg) !important;
            color: var(--text-primary) !important;
        }

        html[data-theme="light"] .creator-card {
            background: var(--surface-bg) !important;
            border-color: var(--border-color) !important;
            color: var(--text-primary);
        }

        html[data-theme="light"] .creator-tagline,
        html[data-theme="light"] .voting-heading p {
            color: var(--text-secondary) !important;
        }

        html[data-theme="light"] .creator-photo {
            background: var(--surface-raised);
            color: var(--text-primary);
        }

        html[data-theme="light"] .leaderboard-box {
            background: var(--surface-bg);
            border-color: var(--border-color);
        }

            html[data-theme="light"] .leaderboard-box h3 {
                color: var(--text-primary);
            }

            html[data-theme="light"] .leaderboard-box p {
                color: var(--text-secondary);
            }

        @@media (max-width: 575.98px) {
            .theme-toggle {
                margin: 12px 0;
            }

            .navbar-collapse {
                padding-bottom: 12px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    CreatorHub
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="@(isGerman ? "Navigation öffnen oder schließen" : "Toggle navigation")">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between"
                     id="mainNavbar">

                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                @T["Home"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Voting"
                               asp-action="Index">
                                @(isGerman ? "Abstimmen" : "Vote")
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Voting"
                               asp-action="Leaderboard">
                                @(isGerman ? "Rangliste" : "Leaderboard")
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                @(isGerman ? "Datenschutz" : "Privacy")
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <form asp-controller="Language"
                              asp-action="SetLanguage"
                              method="post"
                              class="d-flex align-items-center gap-1 mb-0">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@(Context.Request.Path + Context.Request.QueryString)" />

                            <button type="submit"
                                    name="culture"
                                    value="de-DE"
                                    class="btn btn-sm btn-outline-danger"
                                    aria-label="Deutsch auswählen"
                                    aria-pressed="@(isGerman ? "true" : "false")">
                                DE
                            </button>

                            <button type="submit"
                                    name="culture"
                                    value="en-US"
                                    class="btn btn-sm btn-outline-danger"
                                    aria-label="Choose English"
                                    aria-pressed="@(!isGerman ? "true" : "false")">
                                EN
                            </button>
                        </form>

                        <button id="themeToggle"
                                class="theme-toggle"
                                type="button"
                                aria-label="@themeAriaLabel"
                                aria-pressed="false">
                            <span id="themeIcon" aria-hidden="true">☀️</span>
                            <span id="themeLabel">@themeLabel</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            &copy; @DateTime.Now.Year - CreatorHub -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                @(isGerman ? "Datenschutz" : "Privacy")
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const toggle = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");
            const label = document.getElementById("themeLabel");
            const root = document.documentElement;
            const isGerman = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isGerman));

            if (!toggle || !icon || !label) return;

            function applyTheme(theme) {
                const isDark = theme === "dark";

                root.setAttribute("data-theme", theme);
                icon.textContent = isDark ? "☀️" : "🌙";
                label.textContent = isDark
                    ? (isGerman ? "Helles Design" : "Light Mode")
                    : (isGerman ? "Dunkles Design" : "Dark Mode");

                toggle.setAttribute(
                    "aria-label",
                    isDark
                        ? (isGerman ? "Zum hellen Design wechseln" : "Switch to light mode")
                        : (isGerman ? "Zum dunklen Design wechseln" : "Switch to dark mode")
                );

                toggle.setAttribute("aria-pressed", String(!isDark));

                try {
                    localStorage.setItem("creatorhub-theme", theme);
                } catch {
                    // The theme still works if storage is unavailable.
                }
            }

            toggle.addEventListener("click", function () {
                const currentTheme = root.getAttribute("data-theme") || "dark";
                applyTheme(currentTheme === "dark" ? "light" : "dark");
            });

            applyTheme(root.getAttribute("data-theme") || "dark");
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
