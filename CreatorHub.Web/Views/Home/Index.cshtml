            <p class="lede2">
                @(isGerman
                                ? "CreatorHub vereint Creator von BIG7, Frivol, MDH und Amateur in einer durchsuchbaren Entdeckungsplattform."
                                : "CreatorHub brings creators from BIG7, Frivol, MDH and Amateur into one searchable discovery experience.")
            </p>

            <div class="three">
                <div>
                    <h3 class="cond">@(isGerman ? "Entdecken" : "Discover")</h3>
                    <p>
                        @(isGerman
                                                ? "Finde Creator anhand von Namen, Kategorien und Plattformen."
                                                : "Find creators based on names, categories and platforms.")
                    </p>
                </div>
                <div>
                    <h3 class="cond">@(isGerman ? "Erkunden" : "Explore")</h3>
                    <p>
                        @(isGerman
                                                ? "Sieh dir Creator-Profile und ihre Präsenz auf verschiedenen Plattformen an."
                                                : "View creator profiles and their platform presence.")
                    </p>
                </div>
                <div>
                    <h3 class="cond">@(isGerman ? "Verbinden" : "Connect")</h3>
                    <p>
                        @(isGerman
                                                ? "Finde heraus, auf welchen Plattformen deine Lieblings-Creator aktiv sind."
                                                : "Discover where your favorite creators are active.")
                    </p>
                </div>
