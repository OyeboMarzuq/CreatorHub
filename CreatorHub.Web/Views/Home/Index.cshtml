@{
    ViewData["Title"] = "CreatorHub | Where creators get discovered";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --red: #E10600;
            --red-d: #B80500;
            --black: #0A0A0A;
            --white: #fff;
            --grey: #F2F2F2;
            --mute: #6b6b6b;
            --cond: 'Anton','Impact','Arial Narrow',sans-serif;
            --serif: 'Instrument Serif','Georgia',serif;
            --sans: 'Manrope','Helvetica Neue',Arial,sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--sans);
            color: var(--black);
            background: var(--white);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, input {
            font: inherit;
        }

        button {
            cursor: pointer;
            border: 0;
            background: none;
            color: inherit;
        }

        :focus-visible {
            outline: 3px solid var(--black);
            outline-offset: 3px;
        }

        .wrap {
            width: min(1240px, calc(100% - 48px));
            margin-inline: auto;
        }

        .cond {
            font-family: var(--cond);
            text-transform: uppercase;
            font-weight: 400;
            line-height: .92;
            letter-spacing: .01em;
        }

        .ital {
            font-family: var(--serif);
            font-style: italic;
            font-weight: 400;
            text-transform: none;
            letter-spacing: -.01em;
        }

        /* HERO AND NAVIGATION */

        .hero {
            background: var(--red);
            color: var(--white);
            padding-bottom: 150px;
            position: relative;
        }

        nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            padding: 26px 0;
        }

        .logo {
            font-family: var(--cond);
            font-size: 28px;
            text-transform: uppercase;
            letter-spacing: .02em;
            white-space: nowrap;
        }

            .logo i {
                font-family: var(--serif);
                font-weight: 400;
                text-transform: none;
            }

        .links {
            display: flex;
            align-items: center;
            gap: 30px;
            font-weight: 700;
            font-size: 14px;
        }

            .links a {
                padding: 4px 0;
                border-bottom: 2px solid transparent;
                transition: border-color .2s;
            }

                .links a:hover,
                .links a.on {
                    border-color: var(--white);
                }

        .nav-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-shrink: 0;
        }

        .admin-link {
            display: inline-block;
            padding: 10px 12px;
            color: var(--white);
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
            border: 1px solid rgba(255,255,255,.6);
        }

            .admin-link:hover {
                background: rgba(255,255,255,.15);
            }

        .join {
            display: inline-block;
            background: var(--black);
            color: var(--white);
            padding: 12px 18px;
            font-weight: 800;
            font-size: 12px;
            white-space: nowrap;
            transition: background .2s, color .2s;
        }

            .join:hover {
                background: var(--white);
                color: var(--black);
            }

        .hero h1 {
            margin-top: 70px;
        }

            .hero h1 .l1 {
                display: block;
                font-size: clamp(56px, 11.5vw, 168px);
            }

            .hero h1 .l2 {
                display: block;
                font-size: clamp(60px, 12.5vw, 184px);
                color: var(--black);
                margin-top: -.04em;
                padding-bottom: .08em;
            }

        .lede {
            max-width: 640px;
            font-size: clamp(16px, 1.5vw, 19px);
            margin-top: 26px;
            font-weight: 500;
        }

        .search {
            margin-top: 40px;
            width: min(72%, 880px);
            display: flex;
            background: var(--white);
            color: var(--black);
            box-shadow: 8px 8px 0 var(--black);
        }

            .search svg {
                flex: none;
                width: 26px;
                height: 26px;
                margin: 0 6px 0 24px;
                align-self: center;
            }

            .search input {
                flex: 1;
                min-width: 0;
                width: 100%;
                border: 0;
                padding: 26px 16px;
                font: 500 19px var(--sans);
                outline: 0;
                background: transparent;
            }

            .search:focus-within {
                outline: 3px solid var(--black);
                outline-offset: 3px;
            }

            .search button {
                flex: none;
                background: var(--black);
                color: var(--white);
                padding: 0 32px;
                font-weight: 800;
                letter-spacing: .12em;
                font-size: 14px;
                transition: background .2s;
            }

                .search button:hover {
                    background: var(--red-d);
                }

        .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 26px;
        }

        .f {
            padding: 9px 20px;
            border: 2px solid var(--white);
            font-weight: 800;
            font-size: 13px;
            letter-spacing: .1em;
            transition: all .15s;
        }

            .f:hover {
                background: rgba(255,255,255,.18);
            }

            .f[aria-pressed="true"] {
                background: var(--black);
                border-color: var(--black);
            }

        /* HERO CARDS */

        .stack {
            position: absolute;
            left: 0;
            right: 0;
            bottom: -120px;
            pointer-events: none;
        }

            .stack .wrap {
                display: flex;
                justify-content: flex-end;
                padding-right: 12px;
            }

        .mini {
            width: 230px;
            min-width: 0;
            padding: 16px;
            margin-left: -34px;
            box-shadow: 0 14px 30px rgba(0,0,0,.28);
            display: flex;
            gap: 12px;
            align-items: center;
        }

            .mini:nth-child(1) {
                background: var(--white);
                color: var(--black);
                transform: rotate(-4deg) translateY(10px);
            }

            .mini:nth-child(2) {
                background: var(--black);
                color: var(--white);
                transform: translateY(-14px);
                z-index: 2;
            }

            .mini:nth-child(3) {
                background: var(--red-d);
                color: var(--white);
                transform: rotate(4deg) translateY(8px);
                border: 2px solid var(--white);
            }

            .mini b {
                display: block;
                font-size: 14px;
                line-height: 1.2;
            }

            .mini small {
                font-size: 12px;
                opacity: .75;
                display: block;
            }

        .av {
            flex: none;
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            font-family: var(--cond);
            font-size: 20px;
        }

            .av.r {
                background: var(--red);
                color: #fff;
            }

            .av.k {
                background: var(--black);
                color: #fff;
            }

            .av.w {
                background: var(--grey);
                color: var(--red);
                border: 2px solid var(--red);
            }

        .tick {
            display: inline-grid;
            place-items: center;
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background: var(--red);
            color: #fff;
            font-size: 9px;
            vertical-align: 1px;
            margin-left: 5px;
        }

        .mini:nth-child(3) .tick,
        .mini:nth-child(2) .tick {
            background: #fff;
            color: var(--red);
        }

        /* GENERAL SECTIONS */

        section {
            padding: 110px 0;
        }

        .sec-h {
            font-size: clamp(44px, 7vw, 96px);
            margin-bottom: 44px;
        }

            .sec-h .ital {
                font-size: 1.1em;
                color: var(--red);
            }

        #results {
            background: var(--grey);
            display: none;
            padding-top: 90px;
        }

            #results.show {
                display: block;
            }

        .rmeta {
            font-weight: 700;
            margin-bottom: 28px;
            color: var(--mute);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 24px;
        }

        .card {
            min-width: 0;
            background: var(--white);
            border: 2px solid var(--black);
            display: flex;
            flex-direction: column;
            transition: transform .2s, box-shadow .2s;
        }

            .card:hover {
                transform: translate(-4px, -4px);
                box-shadow: 8px 8px 0 var(--red);
            }

            .card .ph {
                height: 220px;
                display: grid;
                place-items: center;
                position: relative;
                font-family: var(--cond);
                font-size: 84px;
                color: #fff;
                overflow: hidden;
                isolation: isolate;
                background: var(--red);
            }

        .ph.r {
            background: var(--red);
        }

        .ph.k {
            background: var(--black);
        }

        .ph.w {
            background: var(--grey);
            color: var(--red);
        }

        .ph::after {
            content: "";
            position: absolute;
            inset: auto -20% -45% 30%;
            aspect-ratio: 1;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            z-index: 0;
            pointer-events: none;
        }

        .ph.w::after {
            background: rgba(225,6,0,.08);
        }

        .ph .initials {
            position: relative;
            z-index: 1;
            text-transform: uppercase;
        }

        .ph img {
            position: absolute;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 2;
            background: var(--grey);
        }

        .ph.has-image {
            background: var(--grey);
        }

        .plat {
            position: absolute;
            top: 12px;
            left: 12px;
            background: var(--white);
            color: var(--black);
            font: 800 11px var(--sans);
            letter-spacing: .12em;
            padding: 5px 10px;
            z-index: 3;
            max-width: calc(100% - 24px);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .ph.k .plat {
            background: var(--red);
            color: #fff;
        }

        .cb {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 3px;
            flex: 1;
        }

            .cb h3 {
                font-size: 24px;
                overflow-wrap: anywhere;
            }

            .cb .u {
                color: var(--mute);
                font-weight: 600;
                font-size: 14px;
            }

            .cb .m {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                margin-top: 14px;
                font-size: 13px;
                font-weight: 700;
            }

                .cb .m span:last-child {
                    color: var(--red);
                    text-align: right;
                }

        .vp {
            display: block;
            margin-top: 18px;
            background: var(--black);
            color: #fff;
            text-align: center;
            padding: 12px;
            font-weight: 800;
            font-size: 13px;
            letter-spacing: .1em;
            transition: background .2s;
        }

            .vp:hover {
                background: var(--red);
            }

        .empty {
            padding: 60px 0;
        }

            .empty h3 {
                font-size: clamp(40px, 6vw, 80px);
            }

            .empty p {
                margin-top: 14px;
                font-size: 18px;
            }

        /* PLATFORMS */

        .dark {
            background: var(--black);
            color: var(--white);
        }

            .dark .sec-h .ital {
                color: var(--red);
            }

            .dark .sub {
                max-width: 520px;
                font-size: 18px;
                margin: -12px 0 52px;
                color: #cfcfcf;
            }

        .pgrid {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            grid-auto-rows: minmax(300px, auto);
            gap: 20px;
        }

        .pb {
            padding: 32px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: left;
            transition: transform .2s;
            position: relative;
            overflow: hidden;
            min-width: 0;
        }

            .pb:hover {
                transform: translateY(-6px);
            }

            .pb .n {
                font-family: var(--cond);
                font-size: clamp(46px, 6vw, 92px);
                line-height: .95;
                text-transform: uppercase;
                overflow-wrap: anywhere;
            }

            .pb p {
                max-width: 300px;
                font-weight: 600;
            }

            .pb .go {
                font-weight: 800;
                font-size: 13px;
                letter-spacing: .1em;
                margin-top: 18px;
            }

        .p1 {
            background: var(--red);
            grid-row: span 2;
        }

            .p1 .n {
                font-size: clamp(90px, 15vw, 230px);
            }

        .p2 {
            background: var(--white);
            color: var(--black);
        }

            .p2 .n .ital {
                color: var(--red);
            }

        .p3 {
            border: 2px solid var(--red);
        }

            .p3 .n {
                color: var(--red);
            }

        .p4 {
            grid-column: 1 / -1;
            background: var(--grey);
            color: var(--black);
            flex-direction: row;
            align-items: flex-end;
            gap: 30px;
            flex-wrap: wrap;
            min-height: 220px;
        }

            .p4 .n {
                font-size: clamp(70px, 13vw, 190px);
            }

                .p4 .n span {
                    color: var(--red);
                }

        /* ABOUT */

        .msg .big {
            font-size: clamp(60px, 11vw, 160px);
        }

            .msg .big .ital {
                display: block;
                color: var(--red);
                font-size: 1.08em;
            }

        .msg .lede2 {
            max-width: 600px;
            font-size: 20px;
            margin: 34px 0 80px;
            font-weight: 500;
        }

        .three {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 48px;
            border-top: 4px solid var(--black);
            padding-top: 36px;
        }

            .three h3 {
                font-size: 40px;
                color: var(--red);
                margin-bottom: 10px;
            }

            .three p {
                max-width: 300px;
            }

        /* CALL TO ACTION AND FOOTER */

        .cta {
            background: var(--red);
            color: #fff;
            text-align: center;
            padding: 140px 0;
        }

            .cta h2 {
                font-size: clamp(54px, 11vw, 160px);
            }

                .cta h2 .ital {
                    display: block;
                    color: var(--black);
                    font-size: 1.08em;
                }

            .cta p {
                font-size: 20px;
                margin: 26px 0 40px;
                font-weight: 600;
            }

            .cta a {
                display: inline-block;
                background: var(--black);
                color: #fff;
                padding: 22px 52px;
                font-weight: 800;
                letter-spacing: .12em;
                transition: transform .2s, background .2s;
            }

                .cta a:hover {
                    background: #fff;
                    color: var(--black);
                    transform: translateY(-3px);
                }

        footer {
            background: var(--black);
            color: #fff;
            padding: 70px 0 34px;
        }

        .fg {
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr;
            gap: 40px;
        }

            .fg .logo {
                font-size: 40px;
                color: var(--red);
            }

            .fg h4 {
                font-size: 13px;
                color: #8a8a8a;
                margin-bottom: 14px;
                letter-spacing: .1em;
            }

            .fg li {
                list-style: none;
                margin-bottom: 8px;
                font-weight: 600;
            }

                .fg li a:hover {
                    color: var(--red);
                }

        .copy {
            margin-top: 60px;
            padding-top: 24px;
            border-top: 1px solid #2a2a2a;
            color: #8a8a8a;
            font-size: 14px;
        }

        /* TABLET */

        @@media (max-width: 960px) {
            nav {
                flex-wrap: wrap;
                gap: 14px;
            }

            .links {
                display: none;
            }

            .nav-actions {
                margin-left: auto;
            }

            .hero h1 {
                margin-top: 48px;
            }

            .search {
                width: 100%;
            }

            .stack {
                position: static;
                margin-top: 60px;
                overflow: hidden;
                padding-bottom: 20px;
            }

                .stack .wrap {
                    justify-content: center;
                }

            .hero {
                padding-bottom: 50px;
            }

            .mini:nth-child(3) {
                display: none;
            }

            .pgrid {
                grid-template-columns: 1fr;
            }

            .p1 {
                grid-row: auto;
                min-height: 340px;
            }

            .three, .fg {
                grid-template-columns: 1fr;
            }

            section {
                padding: 80px 0;
            }

            #results {
                padding-top: 70px;
            }
        }

        /* MOBILE NAVIGATION AND LAYOUT */

        @@media (max-width: 560px) {
            .wrap {
                width: calc(100% - 32px);
            }

            nav {
                align-items: flex-start;
                gap: 12px;
                padding: 20px 0;
            }

                nav .logo {
                    font-size: 25px;
                    line-height: 1.2;
                }

            .nav-actions {
                flex: 1;
                min-width: 0;
                flex-wrap: wrap;
                gap: 7px;
            }

                .nav-actions a {
                    text-align: center;
                    padding: 9px 10px;
                    font-size: 10px;
                    white-space: normal;
                }

            .hero h1 {
                margin-top: 42px;
            }

                .hero h1 .l1 {
                    font-size: clamp(45px, 12vw, 66px);
                }

                .hero h1 .l2 {
                    font-size: clamp(45px, 12vw, 68px);
                }

            .lede {
                font-size: 15px;
                margin-top: 20px;
            }

            .search {
                flex-wrap: wrap;
                box-shadow: 5px 5px 0 var(--black);
                margin-top: 28px;
            }

                .search svg {
                    width: 22px;
                    height: 22px;
                    margin-left: 14px;
                }

                .search input {
                    width: 0;
                    flex: 1 1 calc(100% - 60px);
                    padding: 19px 10px;
                    font-size: 14px;
                }

                .search button {
                    width: 100%;
                    padding: 16px;
                }

            .filters {
                gap: 8px;
                margin-top: 22px;
            }

            .f {
                padding: 8px 12px;
                font-size: 11px;
            }

            .stack {
                margin-top: 40px;
            }

            .mini {
                width: 205px;
                padding: 12px;
                margin-left: -22px;
            }

                .mini:nth-child(1) {
                    display: none;
                }

            section {
                padding: 65px 0;
            }

            #results {
                padding-top: 55px;
            }

            .sec-h {
                margin-bottom: 28px;
            }

            .grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .card .ph {
                height: 240px;
            }

            .pgrid {
                gap: 14px;
            }

            .pb {
                padding: 24px;
                min-height: 250px;
            }

            .p1 {
                min-height: 310px;
            }

                .p1 .n {
                    font-size: clamp(80px, 22vw, 130px);
                }

            .p4 {
                align-items: flex-start;
                flex-direction: column;
            }

            .three {
                gap: 28px;
            }

                .three h3 {
                    font-size: 34px;
                }

            .msg .lede2 {
                font-size: 17px;
                margin: 28px 0 48px;
            }

            .cta {
                padding: 85px 0;
            }

                .cta p {
                    font-size: 16px;
                }

                .cta a {
                    padding: 18px 25px;
                    font-size: 12px;
                }

            footer {
                padding: 50px 0 28px;
            }

            .fg {
                gap: 28px;
            }

            .copy {
                margin-top: 35px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>
    <header class="hero" id="home">
        <div class="wrap">
            <nav aria-label="Main navigation">
                <a href="#home" class="logo">Creator<i>Hub</i></a>

                <div class="links">
                    <a href="#home" class="on">Home</a>
                    <a href="#creators">Creators</a>
                    <a href="#platforms">Platforms</a>
                    <a href="#about">About</a>
                </div>

                <div class="nav-actions">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Home" asp-action="Dashboard" class="admin-link">Dashboard</a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="/Home/Dashboard"
                           class="admin-link">Admin Sign In</a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="ChangePassword" class="join">My Account</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="join">Join CreatorHub</a>
                    }
                </div>
            </nav>

            <h1 class="cond">
                <span class="l1">Where creators</span>
                <span class="l2 ital">get discovered.</span>
            </h1>

            <p class="lede">
                Discover creators, explore their profiles, and find the people worth following across BIG7, Frivol, MDH and Amateur.
            </p>

            <form class="search" id="searchForm" role="search" autocomplete="off">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5" />
                    <path d="m20 20-4.9-4.9" />
                </svg>
                <input id="q" type="search"
                       placeholder="Search creators, usernames, categories..."
                       aria-label="Search creators, usernames, categories or platforms" />
                <button type="submit">SEARCH</button>
            </form>

            <div class="filters" role="group" aria-label="Filter by platform">
