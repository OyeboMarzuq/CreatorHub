    <script>
        const $ = selector => document.querySelector(selector);
        const $$ = selector => [...document.querySelectorAll(selector)];

        let plat = 'ALL';
        let searchTimer;
        let activeRequest = 0;

        const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;'
        }[char]));

        // Only allow valid HTTP/HTTPS image and profile URLs.
        function safeUrl(value) {
            try {
                const url = new URL(String(value ?? ''), window.location.origin);
                return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
            } catch {
                return '';
            }
        }

        function profileCard(profile) {
            const username = esc(profile.username || 'Unknown creator');
            const platform = esc(profile.platform || 'CreatorHub');
            const profileUrl = safeUrl(profile.url);
            const imageUrl = safeUrl(
                profile.profileImageUrl ||
                profile.ProfileImageUrl ||
                profile.imageUrl ||
                profile.profileImage
            );

            const initials = String(profile.username || '?')
                .trim()
                .substring(0, 2)
                .toUpperCase();

            const imageMarkup = imageUrl
                ? `<img src="${esc(imageUrl)}"
                        alt="${username} profile picture"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        onerror="this.hidden=true; this.parentElement.classList.remove('has-image');" />`
                : '';

            const page = profile.sourcePage ?? profile.SourcePage ?? '—';

            return `
                <article class="card">
                    <div class="ph r ${imageUrl ? 'has-image' : ''}">
                        <span class="initials">${esc(initials)}</span>
                        ${imageMarkup}
                        <span class="plat">${platform}</span>
                    </div>
                    <div class="cb">
                        <h3 class="cond">${username}</h3>
                        <span class="u">Imported profile</span>
                        <div class="m">
                            <span>Page ${esc(page)}</span>
                            <span>${platform}</span>
                        </div>
                        ${profileUrl
                            ? `<a class="vp" href="${esc(profileUrl)}"
                                  target="_blank" rel="noopener noreferrer">
                                  VIEW ORIGINAL PROFILE
                               </a>`
                            : `<span class="vp">PROFILE URL UNAVAILABLE</span>`
                        }
                    </div>
                </article>`;
        }

        async function run(scroll = false) {
            const requestId = ++activeRequest;
            const searchTerm = $('#q').value.trim();

            const resultsSection = $('#results');
            const resultGrid = $('#rgrid');
            const emptyMessage = $('#empty');
            const resultMeta = $('#rmeta');
            const resultTitle = $('#rtitle');

            resultsSection.classList.add('show');
            resultTitle.textContent = 'Searching...';
            resultMeta.hidden = false;
            resultMeta.textContent = 'Connecting to CreatorHub database...';
            resultGrid.innerHTML = '';
            emptyMessage.hidden = true;

            try {
                const params = new URLSearchParams({
                    q: searchTerm,
                    platform: plat
                });

                const response = await fetch(
                    `/Creators/Search?${params.toString()}`,
                    {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    }
                );

                if (!response.ok) {
                    throw new Error(`Search failed: HTTP ${response.status}`);
                }

                const data = await response.json();

                // Ignore old responses if the user starts another search.
                if (requestId !== activeRequest) return;

                if (!data.success) {
                    throw new Error('The server could not complete the search.');
                }

                const results = Array.isArray(data.results) ? data.results : [];

                resultTitle.textContent = searchTerm
                    ? `Results for "${searchTerm}"`
                    : `Creators on ${plat}`;

                resultMeta.textContent =
                    `${data.count ?? results.length} profile${(data.count ?? results.length) === 1 ? '' : 's'} found`;

                resultGrid.innerHTML = results.map(profileCard).join('');
                emptyMessage.hidden = results.length > 0;

                if (scroll) {
                    resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            } catch (error) {
                if (requestId !== activeRequest) return;

                console.error('CreatorHub search error:', error);
                resultTitle.textContent = 'Search unavailable';
                resultMeta.textContent =
                    'Could not load profiles. Please check your connection and try again.';
                resultGrid.innerHTML = '';
                emptyMessage.hidden = true;
            }
        }

        function setPlat(platform) {
            plat = platform;

            $$('.f').forEach(button => {
                button.setAttribute(
                    'aria-pressed',
                    String(button.dataset.p === platform)
                );
            });
        }

        $('#searchForm').addEventListener('submit', event => {
            event.preventDefault();
            run(true);
        });

        $('#q').addEventListener('input', () => {
            clearTimeout(searchTimer);

            searchTimer = setTimeout(() => {
                if ($('#q').value.trim().length >= 2) {
                    run(false);
                }
            }, 350);
        });

        $$('.f').forEach(button => {
            button.addEventListener('click', () => {
                setPlat(button.dataset.p);
                run(true);
            });
        });

        $$('.pb').forEach(button => {
            button.addEventListener('click', () => {
                setPlat(button.dataset.go);
                $('#q').value = '';
                run(true);
            });
        });

        $('#ctaBtn').addEventListener('click', event => {
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            $('#q').focus({ preventScroll: true });
        });
    </script>
</body>
</html>
