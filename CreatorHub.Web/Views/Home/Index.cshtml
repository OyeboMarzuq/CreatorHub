    <section class="cta">
        <div class="wrap">
            <h2 class="cond">
                @(isGerman ? "Wen wirst du" : "Who will you")
                <span class="ital">@(isGerman ? "als Nächstes entdecken?" : "discover next?")</span>
            </h2>
            <p>
                @(isGerman
                                ? "Beginne jetzt, Creator auf CreatorHub zu entdecken."
                                : "Start exploring creators on CreatorHub.")
            </p>
            <a href="#home" id="ctaBtn">
                @(isGerman ? "CREATOR ENTDECKEN" : "EXPLORE CREATORS")
            </a>
