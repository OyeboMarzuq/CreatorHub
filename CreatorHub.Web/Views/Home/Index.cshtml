    </section>

    <footer>
        <div class="wrap">
            <div class="fg">
                <div><a href="#home" class="logo">Creator<i>Hub</i></a></div>

                <div>
                    <h4>@(isGerman ? "ENTDECKEN" : "EXPLORE")</h4>
                    <ul>
                        <li><a href="#home">@(isGerman ? "Startseite" : "Home")</a></li>
                        <li><a href="#creators">@(isGerman ? "Creator" : "Creators")</a></li>
                        <li><a href="#platforms">@(isGerman ? "Plattformen" : "Platforms")</a></li>
                        <li><a href="#about">@(isGerman ? "Über uns" : "About")</a></li>
                        <li><a href="mailto:contact@creatorhub.com">@(isGerman ? "Kontakt" : "Contact")</a></li>
                    </ul>
                </div>

                <div>
                    <h4>@(isGerman ? "PLATTFORMEN" : "PLATFORMS")</h4>
                    <ul>
                        <li><a href="#platforms">BIG7</a></li>
                        <li><a href="#platforms">Frivol</a></li>
                        <li><a href="#platforms">MDH</a></li>
                    </ul>
                </div>
            </div>

            <p class="copy">© 2026 CreatorHub. @(isGerman ? "Alle Rechte vorbehalten." : "All rights reserved.")</p>
        </div>
    </footer>

    <script>
        (() => {
            'use strict';

            const tr = {
                unknownCreator: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Unbekannter Creator" : "Unknown creator")),
                creatorHub: "CreatorHub",
                importedProfile: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Importiertes Profil" : "Imported profile")),
                profilePicture: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Profilbild" : "profile picture")),
                viewProfile: @Html.Raw(JsonSerializer.Serialize(isGerman ? "ORIGINALPROFIL ANSEHEN" : "VIEW ORIGINAL PROFILE")),
                urlUnavailable: @Html.Raw(JsonSerializer.Serialize(isGerman ? "PROFIL-URL NICHT VERFÜGBAR" : "PROFILE URL UNAVAILABLE")),
                searchUnavailable: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Suche nicht verfügbar" : "Search unavailable")),
                unknownError: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Ein unbekannter Suchfehler ist aufgetreten." : "An unknown search error occurred.")),
                searching: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Suche läuft ..." : "Searching...")),
                connecting: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Verbindung zur CreatorHub-Datenbank ..." : "Connecting to CreatorHub database...")),
                resultsFor: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Ergebnisse für" : "Results for")),
                allCreators: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Alle Creator" : "All creators")),
                creatorsOn: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Creator auf" : "Creators on")),
                profile: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Profil" : "profile")),
                profiles: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Profile" : "profiles")),
                found: @Html.Raw(JsonSerializer.Serialize(isGerman ? "gefunden" : "found")),
                page: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Seite" : "Page")),
                serverError: @Html.Raw(JsonSerializer.Serialize(isGerman ? "Der Server konnte die Suche nicht abschließen." : "The server could not complete the search."))
            };

            const $ = selector => document.querySelector(selector);
            const $$ = selector => [...document.querySelectorAll(selector)];

            const searchForm = $('#searchForm');
            const searchInput = $('#q');
            const resultsSection = $('#results');
            const resultGrid = $('#rgrid');
            const emptyMessage = $('#empty');
            const resultMeta = $('#rmeta');
            const resultTitle = $('#rtitle');

            if (!searchForm || !searchInput || !resultsSection ||
                !resultGrid || !emptyMessage || !resultMeta || !resultTitle) {
                console.error('CreatorHub: Required search or results elements are missing.');
                return;
            }

            let selectedPlatform = 'ALL';
            let searchTimer = null;
            let activeRequest = 0;

            const imagePropertyNames = [
                'profileImageUrl', 'ProfileImageUrl',
                'profilePhotoUrl', 'ProfilePhotoUrl',
                'profilePhoto', 'ProfilePhoto',
                'avatarUrl', 'AvatarUrl', 'avatar', 'Avatar',
                'imageUrl', 'ImageUrl', 'image', 'Image',
                'photoUrl', 'PhotoUrl',
                'thumbnailUrl', 'ThumbnailUrl',
                'pictureUrl', 'PictureUrl',
                'coverImageUrl', 'CoverImageUrl',
                'coverImage', 'CoverImage'
            ];

            const usernamePropertyNames = [
                'username', 'Username', 'nick', 'Nick',
                'displayName', 'DisplayName', 'name', 'Name'
            ];

            const profileUrlPropertyNames = [
                'url', 'Url', 'profileUrl', 'ProfileUrl',
                'profileURL', 'ProfileURL', 'profileLink', 'ProfileLink'
            ];

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[character]));
            }

            function getProperty(object, names) {
                if (!object || typeof object !== 'object') return null;

                for (const name of names) {
                    const value = object[name];
                    if (value !== undefined && value !== null &&
                        String(value).trim() !== '') {
                        return value;
                    }
                }

                const propertyMap = new Map(
                    Object.keys(object).map(key => [key.toLowerCase(), object[key]])
                );

                for (const name of names) {
                    const value = propertyMap.get(name.toLowerCase());
                    if (value !== undefined && value !== null &&
                        String(value).trim() !== '') {
                        return value;
                    }
                }

                return null;
            }

            function safeUrl(value) {
                if (typeof value !== 'string' && typeof value !== 'number') return '';

                const text = String(value).trim();
                if (!text) return '';

                try {
                    const url = new URL(text, window.location.origin);
                    if (!['http:', 'https:'].includes(url.protocol)) return '';
                    return url.href;
                } catch {
                    return '';
                }
            }

            function getUsername(profile) {
                return String(
                    getProperty(profile, usernamePropertyNames) || tr.unknownCreator
                ).trim();
            }

            function getProfileImage(profile) {
                const directImage = getProperty(profile, imagePropertyNames);

                if (directImage) {
                    const url = safeUrl(directImage);
                    if (url) return url;
                }

                const nestedObjects = [
                    profile?.creator, profile?.Creator,
                    profile?.profile, profile?.Profile,
                    profile?.platformProfile, profile?.PlatformProfile,
                    profile?.platform, profile?.Platform,
                    profile?.data, profile?.Data
                ];

                for (const nestedObject of nestedObjects) {
                    const nestedImage = getProperty(nestedObject, imagePropertyNames);
                    if (nestedImage) {
                        const url = safeUrl(nestedImage);
                        if (url) return url;
                    }
                }

                return '';
            }

            function getProfileUrl(profile) {
                return safeUrl(getProperty(profile, profileUrlPropertyNames));
            }

            function getPlatform(profile) {
                const value = getProperty(profile, [
                    'platformName', 'PlatformName', 'platform', 'Platform',
                    'source', 'Source'
                ]);

                if (!value || typeof value === 'object') return tr.creatorHub;
                return String(value).trim() || tr.creatorHub;
            }

            function getSourcePage(profile) {
                return getProperty(profile, [
                    'sourcePage', 'SourcePage', 'page', 'Page'
                ]) ?? '—';
            }

            function getInitials(username) {
                return escapeHtml(
                    String(username || '?').trim().substring(0, 2).toUpperCase() || '?'
                );
            }

            function profileCard(profile) {
                const usernameText = getUsername(profile);
                const username = escapeHtml(usernameText);
                const platform = escapeHtml(getPlatform(profile));
                const profileUrl = getProfileUrl(profile);
                const imageUrl = getProfileImage(profile);
                const initials = getInitials(usernameText);
                const sourcePage = escapeHtml(getSourcePage(profile));

                const imageMarkup = imageUrl
                    ? `
                        <img
                            src="${escapeHtml(imageUrl)}"
                            alt="${username} ${tr.profilePicture}"
                            loading="lazy"
                            decoding="async"
                            onerror="
                                console.error('CreatorHub image failed to load:', this.src);
                                this.parentElement.classList.remove('has-image');
                                this.remove();
                            "
                        />
                    `
                    : '';

                const profileAction = profileUrl
                    ? `
                        <a class="vp"
                           href="${escapeHtml(profileUrl)}"
                           target="_blank"
                           rel="noopener noreferrer">
                            ${tr.viewProfile}
                        </a>
                    `
                    : `<span class="vp">${tr.urlUnavailable}</span>`;

                return `
                    <article class="card">
                        <div class="ph r ${imageUrl ? 'has-image' : ''}">
                            <span class="initials">${initials}</span>
                            ${imageMarkup}
                            <span class="plat">${platform}</span>
                        </div>
                        <div class="cb">
                            <h3 class="cond">${username}</h3>
                            <span class="u">${tr.importedProfile}</span>
                            <div class="m">
                                <span>${tr.page} ${sourcePage}</span>
                                <span>${platform}</span>
                            </div>
                            ${profileAction}
                        </div>
                    </article>
                `;
            }

            function getResults(data) {
                if (Array.isArray(data)) return data;

                const possibleResults = [
                    data?.results, data?.Results,
                    data?.items, data?.Items,
                    data?.profiles, data?.Profiles
                ];

                return possibleResults.find(Array.isArray) || [];
            }

            function getResultCount(data, results) {
                const count = getProperty(data, [
                    'count', 'Count', 'total', 'Total',
                    'totalCount', 'TotalCount'
                ]);

                const number = Number(count);
                return Number.isFinite(number) && number >= 0
                    ? number
                    : results.length;
            }

            function setPlatform(platform) {
                selectedPlatform = String(platform || 'ALL').toUpperCase();

                $$('.f').forEach(button => {
                    button.setAttribute(
                        'aria-pressed',
                        String(String(button.dataset.p || '').toUpperCase() === selectedPlatform)
                    );
                });
            }

            function showEmptyMessage(show) {
                emptyMessage.hidden = !show;
            }

            function showSearchError(error) {
                console.error('CreatorHub search error:', error);
                resultTitle.textContent = tr.searchUnavailable;
                resultMeta.textContent = error?.message || tr.unknownError;
                resultGrid.innerHTML = '';
                showEmptyMessage(false);
            }

            async function runSearch(scroll = false) {
                const requestId = ++activeRequest;
                const searchTerm = searchInput.value.trim();

                resultsSection.classList.add('show');
                resultTitle.textContent = tr.searching;
                resultMeta.hidden = false;
                resultMeta.textContent = tr.connecting;
                resultGrid.innerHTML = '';
                showEmptyMessage(false);

                try {
                    const params = new URLSearchParams({
                        q: searchTerm,
                        platform: selectedPlatform
                    });

                    const searchUrl =
                        '@Url.Action("Search", "Creators")' + '?' + params.toString();

                    const response = await fetch(searchUrl, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' },
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error(`Search failed with HTTP ${response.status}.`);
                    }

                    const data = await response.json();

                    if (requestId !== activeRequest) return;

                    if (data && typeof data === 'object' &&
                        (data.success === false || data.Success === false)) {
                        throw new Error(
                            data.message || data.Message || tr.serverError
                        );
                    }

                    const results = getResults(data);
                    const count = getResultCount(data, results);

                    resultTitle.textContent = searchTerm
                        ? `${tr.resultsFor} "${searchTerm}"`
                        : selectedPlatform === 'ALL'
                            ? tr.allCreators
                            : `${tr.creatorsOn} ${selectedPlatform}`;

                    resultMeta.textContent =
                        `${count} ${count === 1 ? tr.profile : tr.profiles} ${tr.found}`;

                    resultGrid.innerHTML = results.map(profileCard).join('');
                    showEmptyMessage(results.length === 0);

                    if (scroll) {
                        resultsSection.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                } catch (error) {
                    if (requestId !== activeRequest) return;
                    showSearchError(error);
                }
            }

            searchForm.addEventListener('submit', event => {
                event.preventDefault();
                clearTimeout(searchTimer);
                runSearch(true);
            });

            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimer);
                const value = searchInput.value.trim();

                searchTimer = setTimeout(() => {
                    if (value.length >= 2 || value.length === 0) {
                        runSearch(false);
                    }
                }, 350);
            });

            $$('.f').forEach(button => {
                button.addEventListener('click', () => {
                    setPlatform(button.dataset.p);
                    runSearch(true);
                });
            });

            $$('.pb').forEach(button => {
                button.addEventListener('click', () => {
                    const platform = button.dataset.go;
                    if (!platform) return;

                    setPlatform(platform);
                    searchInput.value = '';
                    runSearch(true);
                });
            });

            const ctaButton = $('#ctaBtn');

            if (ctaButton) {
                ctaButton.addEventListener('click', event => {
                    event.preventDefault();

                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    searchInput.focus({ preventScroll: true });
                });
            }

            setPlatform('ALL');
        })();
    </script>

    <script>
        (() => {
            const toggle = document.getElementById("homeThemeToggle");
            const icon = document.getElementById("homeThemeIcon");
            const label = document.getElementById("homeThemeLabel");
            const root = document.documentElement;
            const isGerman = root.lang.toLowerCase().startsWith("de");

            if (!toggle || !icon || !label) return;

            function applyTheme(theme) {
                const isDark = theme === "dark";

                root.setAttribute("data-theme", theme);
                icon.textContent = isDark ? "☀️" : "🌙";

                label.textContent = isDark
                    ? (isGerman ? "Heller Modus" : "Light Mode")
                    : (isGerman ? "Dunkler Modus" : "Dark Mode");

                toggle.setAttribute(
                    "aria-label",
                    isDark
                        ? (isGerman ? "Zum hellen Modus wechseln" : "Switch to light mode")
                        : (isGerman ? "Zum dunklen Modus wechseln" : "Switch to dark mode")
                );

                toggle.setAttribute("aria-pressed", String(!isDark));

                try {
                    localStorage.setItem("creatorhub-theme", theme);
                } catch {
                    // The theme still works for this page.
                }
            }

            toggle.addEventListener("click", () => {
                const current = root.getAttribute("data-theme") || "dark";
                applyTheme(current === "dark" ? "light" : "dark");
            });

            applyTheme(root.getAttribute("data-theme") || "dark");
        })();
    </script>
</body>
</html>
