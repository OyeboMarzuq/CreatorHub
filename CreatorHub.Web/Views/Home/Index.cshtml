    <section class="msg" id="about">
        <div class="wrap">
            <h2 class="big cond">
                @(isGerman ? "Finde Menschen" : "Find people")
                <span class="ital">
                    @(isGerman ? "die es wert sind, ihnen zu folgen." : "worth following.")
                </span>
