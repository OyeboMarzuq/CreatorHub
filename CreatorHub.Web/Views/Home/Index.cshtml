    <section class="dark" id="platforms">
        <div class="wrap">
            <h2 class="sec-h cond">
                @(isGerman ? "Vier Plattformen." : "Four platforms.")
                <br />
                <span class="ital">@(isGerman ? "Ein Creator-Hub." : "One creator hub.")</span>
            </h2>

            <p class="sub">
                @(isGerman
                                ? "Entdecke Creator auf den Plattformen, die CreatorHub verbinden."
                                : "Discover creators across the platforms that power CreatorHub.")
            </p>

            <div class="pgrid">
                <button type="button" class="pb p1" data-go="BIG7">
                    <span class="n">01 /<br />BIG7</span>
                    <span>
                        <p>
                            @(isGerman
                                                        ? "Entdecke Creator und Profile von BIG7."
                                                        : "Creator discovery and profiles from BIG7.")
                        </p>
                        <span class="go">@(isGerman ? "BIG7 DURCHSUCHEN" : "BROWSE BIG7")</span>
                    </span>
                </button>

                <button type="button" class="pb p2" data-go="FRIVOL">
                    <span class="n">02 / <span class="ital">Frivol</span></span>
                    <span>
                        <p>
                            @(isGerman
                                                        ? "Entdecke Creator und Profile von Frivol."
                                                        : "Discover creators and profiles from Frivol.")
                        </p>
                        <span class="go">@(isGerman ? "FRIVOL DURCHSUCHEN" : "BROWSE FRIVOL")</span>
                    </span>
                </button>

                <button type="button" class="pb p3" data-go="MDH">
                    <span class="n">03 / MDH</span>
                    <span>
