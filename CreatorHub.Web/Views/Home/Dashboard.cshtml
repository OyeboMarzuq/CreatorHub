@model CreatorHub.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var adminName = User.Identity?.Name ?? "Admin";
    var initial = adminName.Length > 0 ? adminName.Substring(0, 1).ToUpperInvariant() : "A";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | CreatorHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --red: #E10600;
            --red-dark: #B80500;
            --black: #0A0A0A;
            --white: #FFFFFF;
            --grey: #F2F2F2;
            --muted: #6B6B6B;
            --border: #E4E4E4;
            --cond: 'Anton', Impact, sans-serif;
            --serif: 'Instrument Serif', Georgia, serif;
            --sans: 'Manrope', Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--sans);
            color: var(--black);
            background: var(--grey);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

            a:focus-visible, button:focus-visible {
                outline: 3px solid var(--red);
                outline-offset: 4px;
            }

        .container {
            width: min(1240px, calc(100% - 48px));
            margin-inline: auto;
        }

        .cond {
            font-family: var(--cond);
            font-weight: 400;
            text-transform: uppercase;
            line-height: 1;
            letter-spacing: .015em;
        }

        .ital {
            font-family: var(--serif);
            font-weight: 400;
            font-style: italic;
            text-transform: none;
        }

        /* Navigation */
        .topbar {
            background: var(--black);
            color: var(--white);
        }

        .topbar-inner {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
        }

        .logo {
            font-family: var(--cond);
            font-size: 28px;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .logo span {
                color: var(--red);
                font-family: var(--serif);
            }

        .nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(18px, 3vw, 36px);
        }

            .nav a {
                color: #BDBDBD;
                font-size: 13px;
                font-weight: 800;
                padding: 9px 0;
                border-bottom: 2px solid transparent;
                transition: color .2s, border-color .2s;
            }

                .nav a:hover, .nav a.active {
                    color: var(--white);
                    border-color: var(--red);
                }

        .admin {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }

        .admin-avatar {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            background: var(--red);
            color: var(--white);
            font-family: var(--cond);
            font-size: 20px;
        }

        /* Page heading */
        .hero {
            background: var(--red);
            color: var(--white);
            padding: 56px 0 78px;
        }

        .hero-inner {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 32px;
        }

        .eyebrow {
            margin-bottom: 16px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .17em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(56px, 8vw, 108px);
            overflow-wrap: anywhere;
        }

            .hero h1 .ital {
                display: block;
                color: var(--black);
                margin-top: 5px;
            }

        .hero-description {
            max-width: 460px;
            margin-top: 20px;
            font-size: 15px;
            font-weight: 600;
            line-height: 1.8;
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            min-height: 48px;
            padding: 13px 22px;
            background: var(--black);
            border: 2px solid var(--black);
            color: var(--white);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            transition: background .2s, color .2s;
            white-space: nowrap;
        }

            .button:hover {
                background: var(--white);
                color: var(--black);
            }

        /* Statistics */
        .stats-wrap {
            position: relative;
            margin-top: -38px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            border: 2px solid var(--black);
            box-shadow: 7px 7px 0 var(--black);
        }

        .stat {
            min-width: 0;
            min-height: 190px;
            padding: 24px;
            background: var(--white);
            border-right: 1px solid var(--border);
        }

            .stat:last-child {
                border-right: 0;
            }

            .stat.dark {
                background: var(--black);
                color: var(--white);
            }

            .stat.red {
                background: var(--red);
                color: var(--white);
            }

        .stat-label {
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .stat-number {
            display: block;
            margin: 16px 0 9px;
            font-family: var(--cond);
            font-size: clamp(43px, 5vw, 72px);
            line-height: 1;
            overflow-wrap: anywhere;
        }

        .stat-description {
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
        }

        .stat.dark .stat-description {
            color: #C5C5C5;
        }

        .stat.red .stat-description {
            color: #FFE0DE;
        }

        /* Main content */
        main {
            padding: 58px 0 88px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 22px;
        }

            .section-heading h2 {
                font-size: clamp(35px, 4vw, 50px);
            }

                .section-heading h2 .ital {
                    color: var(--red);
                }

        .section-description {
            margin-top: 8px;
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(300px, 1fr);
            gap: 24px;
            align-items: stretch;
        }

        .panel {
            min-width: 0;
            background: var(--white);
            border: 2px solid var(--black);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 24px;
            border-bottom: 1px solid var(--border);
        }

            .panel-header h3 {
                font-size: 27px;
            }

        .panel-body {
            padding: 24px;
        }

        .text-link {
            color: var(--red);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .text-link:hover {
                color: var(--red-dark);
                text-decoration: underline;
            }

        .empty-state {
            min-height: 265px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            border: 2px dashed #D7D7D7;
            text-align: center;
        }

        .empty-icon {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            margin-bottom: 18px;
            background: #FFF0EF;
            color: var(--red);
            font-size: 25px;
        }

        .empty-state h4 {
            font-size: 30px;
        }

        .empty-state p {
            max-width: 330px;
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        /* Importer status */
        .source-card {
            padding: 19px;
            border: 1px solid var(--border);
            margin-bottom: 14px;
        }

            .source-card:last-child {
                margin-bottom: 0;
            }

        .source-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .source-name {
            font-family: var(--cond);
            font-size: 27px;
            text-transform: uppercase;
        }

            .source-name .ital {
                color: var(--red);
            }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 5px 9px;
            background: #E8F7ED;
            color: #176B35;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

            .status::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
            }

            .status.pending {
                background: #FFF3D7;
                color: #855700;
            }

        .source-description {
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .progress-track {
            height: 7px;
            margin-top: 16px;
            background: #EDEDED;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--red);
        }

        .progress-labels {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 8px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 800;
        }

        /* Quick actions */
        .quick-actions {
            margin-top: 58px;
        }

        .action-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .action-card {
            display: flex;
            min-height: 200px;
            flex-direction: column;
            justify-content: space-between;
            padding: 25px;
            background: var(--black);
            color: var(--white);
            transition: background .2s, transform .2s;
        }

            .action-card:nth-child(2) {
                background: var(--white);
                color: var(--black);
                border: 2px solid var(--black);
            }

            .action-card:hover {
                background: var(--red);
                color: var(--white);
                transform: translateY(-3px);
            }

            .action-card h3 {
                font-size: clamp(32px, 3vw, 43px);
            }

            .action-card p {
                max-width: 260px;
                margin-top: 12px;
                font-size: 12px;
                font-weight: 600;
                opacity: .8;
            }

        .action-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .09em;
        }

        .footer {
            padding: 23px 0;
            background: var(--black);
            color: #BDBDBD;
            font-size: 11px;
            font-weight: 600;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        @@media (max-width: 1000px) {
            .topbar-inner {
                gap: 20px;
            }

            .nav {
                gap: 16px;
            }

                .nav a {
                    font-size: 11px;
                }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stat:nth-child(2) {
                border-right: 0;
            }

            .stat:nth-child(-n+2) {
                border-bottom: 1px solid var(--border);
            }

            .overview-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 680px) {
            .container {
                width: calc(100% - 32px);
            }

            .topbar-inner {
                min-height: 68px;
                flex-wrap: wrap;
                padding: 14px 0;
            }

            .nav {
                order: 3;
                width: 100%;
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 4px;
            }

                .nav a {
                    flex-shrink: 0;
                }

            .admin span {
                display: none;
            }

            .hero {
                padding: 42px 0 65px;
            }

            .hero-inner {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero h1 {
                font-size: clamp(49px, 12vw, 76px);
            }

            .hero-description {
                font-size: 13px;
            }

            .stats-wrap {
                margin-top: -30px;
            }

            .stats {
                box-shadow: 4px 4px 0 var(--black);
            }

            .stat {
                min-height: 150px;
                padding: 17px;
            }

            .stat-number {
                font-size: clamp(38px, 10vw, 58px);
                margin: 12px 0 7px;
            }

            .stat-label {
                font-size: 9px;
            }

            main {
                padding-top: 43px;
            }

            .panel-header, .panel-body {
                padding: 18px;
            }

                .panel-header h3 {
                    font-size: 23px;
                }

            .section-heading h2 {
                font-size: 38px;
            }

            .action-grid {
                grid-template-columns: 1fr;
            }

            .action-card {
                min-height: 165px;
            }
        }

        @@media (max-width: 380px) {
            .container {
                width: calc(100% - 24px);
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .stat {
                min-height: 125px;
                border-right: 0;
                border-bottom: 1px solid var(--border);
            }

                .stat:last-child {
                    border-bottom: 0;
                }

            .stat-number {
                font-size: 52px;
            }

            .section-heading {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }

        /* Admin additions */
        .nav a.soon, .action-card.soon {
            opacity: .45;
            pointer-events: none;
            cursor: default;
        }

        .logout-form {
            margin: 0;
        }

        .logout {
            padding: 9px 14px;
            border: 1px solid #3a3a3a;
            color: #BDBDBD;
            font: inherit;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background .2s, color .2s, border-color .2s;
        }

            .logout:hover {
                background: var(--red);
                border-color: var(--red);
                color: var(--white);
            }

        .members {
            margin-top: 24px;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table.members-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .members-table th {
            text-align: left;
            padding: 14px 24px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .members-table td {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            white-space: nowrap;
        }

        .members-table tr:last-child td {
            border-bottom: 0;
        }

        .members-table td.mute {
            color: var(--muted);
            font-weight: 500;
        }

        .members-table .who {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .members-table .dot {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            background: var(--black);
            color: var(--white);
            font-family: var(--cond);
            font-size: 16px;
        }

        .source-list .source-card + .source-card {
            margin-top: 16px;
        }
    </style>
</head>

<body>
    <nav class="topbar">
        <div class="container topbar-inner">
            <a asp-controller="Home" asp-action="Dashboard" class="logo">Creator<span>Hub</span></a>

            <div class="nav" aria-label="Admin navigation">
                <a asp-controller="Home" asp-action="Dashboard" class="active">Dashboard</a>
                <a asp-controller="Creators" asp-action="Index">Creators</a>
                <a class="soon" title="Coming soon">Platforms</a>
                <a class="soon" title="Coming soon">Imports</a>
            </div>

            <div class="admin">
                <span>@adminName</span>
                <div class="admin-avatar">@initial</div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="logout">Log out</button>
                </form>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container hero-inner">
            <div>
                <div class="eyebrow">Creator management system</div>
                <h1 class="cond">Creator <span class="ital">Hub dashboard</span></h1>
                <p class="hero-description">
                    One place to manage creators, monitor profile imports,
                    and keep your members and connected platforms organised.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="button">
                View site <span aria-hidden="true">↗</span>
            </a>
        </div>
    </header>

    <div class="container stats-wrap">
        <section class="stats" aria-label="Dashboard statistics">
            <article class="stat dark">
                <span class="stat-label">Total creators</span>
                <strong class="stat-number">@Model.TotalCreators.ToString("N0")</strong>
                <p class="stat-description">Creator records in the system</p>
            </article>

            <article class="stat red">
                <span class="stat-label">Profile URLs</span>
                <strong class="stat-number">@Model.TotalProfileUrls.ToString("N0")</strong>
                <p class="stat-description">Collected across all platforms</p>
            </article>

            <article class="stat">
                <span class="stat-label">Members</span>
                <strong class="stat-number">@Model.TotalMembers.ToString("N0")</strong>
                <p class="stat-description">Registered accounts</p>
            </article>

            <article class="stat">
                <span class="stat-label">Platforms</span>
                <strong class="stat-number">@Model.TotalPlatforms</strong>
                <p class="stat-description">Configured sources</p>
            </article>
        </section>
    </div>

    <main>
        <div class="container">
            <section class="overview-grid">
                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h3 class="cond">Creators <span class="ital">overview</span></h3>
                            <p class="section-description">Creators processed and saved into CreatorHub.</p>
                        </div>
                        <a asp-controller="Creators" asp-action="Index" class="text-link">View all ↗</a>
                    </div>

                    <div class="panel-body">
                        @if (Model.TotalCreators > 0)
                        {
                            <div class="source-card">
                                <div class="source-top">
                                    <strong>Creator records available</strong>
                                    <span class="status">Available</span>
                                </div>
                                <p class="source-description">
                                    There are @Model.TotalCreators.ToString("N0") creator records in the system,
                                    @Model.ActiveCreators.ToString("N0") of them active.
                                    Open the creators section to browse them.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-icon" aria-hidden="true">＋</div>
                                <h4 class="cond">No creators yet</h4>
                                <p>
                                    Profile URLs have been collected.
                                    Creator records will appear here after profile processing runs.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h3 class="cond">Import <span class="ital">status</span></h3>
                            <p class="section-description">Profile processing by source</p>
                        </div>
                    </div>

                    <div class="panel-body source-list">
                        @if (Model.Sources.Count == 0)
                        {
                            <p class="section-description">No profile URLs have been collected yet.</p>
                        }

                        @foreach (var src in Model.Sources)
                        {
                            <div class="source-card">
                                <div class="source-top">
                                    <span class="source-name"><span class="ital">@src.Source</span></span>
                                    @if (src.Percent >= 100)
                                    {
                                        <span class="status">Complete</span>
                                    }
                                    else
                                    {
                                        <span class="status pending">Pending</span>
                                    }
                                </div>
                                <p class="source-description">
                                    @src.Processed.ToString("N0") processed · @((src.Total - src.Processed).ToString("N0")) pending
                                </p>
                                <div class="progress-track">
                                    <div class="progress-fill" style="width:@(src.Percent)%"></div>
                                </div>
                                <div class="progress-labels">
                                    <span>@src.Total.ToString("N0") URLs collected</span>
                                    <span>@src.Percent%</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <section class="panel members">
                <div class="panel-header">
                    <div>
                        <h3 class="cond">Recent <span class="ital">members</span></h3>
                        <p class="section-description">The latest people who signed up.</p>
                    </div>
                    <span class="text-link">@Model.TotalMembers.ToString("N0") total</span>
                </div>

                @if (Model.RecentMembers.Count == 0)
                {
                    <div class="panel-body">
                        <p class="section-description">Nobody has signed up yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="members-table">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Email</th>
                                    <th>Region</th>
                                    <th>Gender</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.RecentMembers)
                                {
                                    <tr>
                                        <td>
                                            <div class="who">
                                                <span class="dot">@m.Name.Substring(0, 1).ToUpperInvariant()</span>
                                                @m.Name
                                            </div>
                                        </td>
                                        <td class="mute">@m.Email</td>
                                        <td>@m.Region</td>
                                        <td>@m.Gender</td>
                                        <td class="mute">@m.JoinedAt.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="quick-actions">
                <div class="section-heading">
                    <div>
                        <h2 class="cond">Quick <span class="ital">actions</span></h2>
                        <p class="section-description">Jump straight to the section you need.</p>
                    </div>
                </div>

                <div class="action-grid">
                    <a asp-controller="Creators" asp-action="Index" class="action-card">
                        <div>
                            <h3 class="cond">Creators</h3>
                            <p>View and manage creator records and profile details.</p>
                        </div>
                        <div class="action-footer"><span>OPEN CREATORS</span><span>↗</span></div>
                    </a>

                    <a class="action-card soon">
                        <div>
                            <h3 class="cond">Platforms</h3>
                            <p>Manage connected platforms and their collection settings.</p>
                        </div>
                        <div class="action-footer"><span>COMING SOON</span><span>·</span></div>
                    </a>

                    <a class="action-card soon">
                        <div>
                            <h3 class="cond">Imports</h3>
                            <p>Review collected URLs and monitor profile processing.</p>
                        </div>
                        <div class="action-footer"><span>COMING SOON</span><span>·</span></div>
                    </a>
                </div>
            </section>
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>© @DateTime.UtcNow.Year CreatorHub</span>
            <span>Creator management · Platform imports</span>
        </div>
    </footer>
</body>
</html>
