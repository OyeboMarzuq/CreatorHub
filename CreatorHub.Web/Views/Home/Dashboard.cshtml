@model CreatorHub.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var adminName = User.Identity?.Name ?? "Admin";
    var initial = adminName.Length > 0
        ? adminName.Substring(0, 1).ToUpperInvariant()
        : "A";
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="format-detection" content="telephone=no" />
    <title>@ViewData["Title"] | CreatorHub</title>

    <script>
        (function () {
            try {
                const saved = localStorage.getItem("creatorhub-theme");
                document.documentElement.dataset.theme =
                    saved === "light" ? "light" : "dark";
            } catch {
                document.documentElement.dataset.theme = "dark";
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --red: #E10600;
            --red-dark: #B80500;
            --cond: 'Anton', Impact, sans-serif;
            --serif: 'Instrument Serif', Georgia, serif;
            --sans: 'Manrope', Arial, sans-serif;
            --page: #101010;
            --surface: #191919;
            --surface-alt: #222222;
            --text: #F5F5F5;
            --muted: #B8B8B8;
            --border: #3A3A3A;
            --nav: #050505;
            --shadow: #000000;
            --input: #202020;
        }

        html[data-theme="light"] {
            --page: #F2F2F2;
            --surface: #FFFFFF;
            --surface-alt: #F6F6F6;
            --text: #0A0A0A;
            --muted: #6B6B6B;
            --border: #E4E4E4;
            --nav: #0A0A0A;
            --shadow: #0A0A0A;
            --input: #FFFFFF;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            padding-left: env(safe-area-inset-left);
            padding-right: env(safe-area-inset-right);
            font-family: var(--sans);
            color: var(--text);
            background: var(--page);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            transition: background .2s, color .2s;
        }

        a {
            color: inherit;
            text-decoration: none;
            -webkit-tap-highlight-color: transparent;
        }

        button {
            font: inherit;
            appearance: none;
            -webkit-appearance: none;
            border-radius: 0;
            -webkit-tap-highlight-color: transparent;
        }

            a:focus-visible, button:focus-visible {
                outline: 3px solid var(--red);
                outline-offset: 4px;
            }

        .container {
            width: min(1240px, calc(100% - 48px));
            margin-inline: auto;
        }

        .cond {
            font-family: var(--cond);
            font-weight: 400;
            text-transform: uppercase;
            line-height: 1;
            letter-spacing: .015em;
        }

        .ital {
            font-family: var(--serif);
            font-weight: 400;
            font-style: italic;
            text-transform: none;
        }

        /* Navigation */
        .topbar {
            padding-top: env(safe-area-inset-top);
            background: var(--nav);
            color: #FFFFFF;
        }

        .topbar-inner {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .logo {
            font-family: var(--cond);
            font-size: 28px;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .logo span {
                color: var(--red);
                font-family: var(--serif);
            }

        .nav {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(14px, 2vw, 28px);
        }

            .nav a {
                display: inline-flex;
                align-items: center;
                min-height: 44px;
                color: #BDBDBD;
                font-size: 12px;
                font-weight: 800;
                border-bottom: 2px solid transparent;
                transition: color .2s, border-color .2s;
                white-space: nowrap;
            }

                .nav a:hover, .nav a.active {
                    color: #FFFFFF;
                    border-color: var(--red);
                }

                .nav a.soon, .action-card.soon {
                    opacity: .45;
                    pointer-events: none;
                    cursor: default;
                }

        .admin {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .admin-avatar {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            background: var(--red);
            color: #FFFFFF;
            font-family: var(--cond);
            font-size: 20px;
        }

        .theme-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 44px;
            padding: 8px 11px;
            border: 1px solid #444444;
            background: transparent;
            color: #FFFFFF;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
        }

            .theme-toggle:hover {
                background: #292929;
            }

        .logout-form {
            margin: 0;
        }

        .logout {
            min-height: 44px;
            padding: 9px 12px;
            border: 1px solid #3A3A3A;
            background: transparent;
            color: #BDBDBD;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background .2s, color .2s;
        }

            .logout:hover {
                background: var(--red);
                border-color: var(--red);
                color: #FFFFFF;
            }

        /* Hero */
        .hero {
            background: var(--red);
            color: #FFFFFF;
            padding: 56px 0 78px;
        }

        .hero-inner {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 32px;
        }

        .eyebrow {
            margin-bottom: 16px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .17em;
            text-transform: uppercase;
        }

        .hero h1 {
            font-size: clamp(56px, 8vw, 108px);
            overflow-wrap: anywhere;
        }

            .hero h1 .ital {
                display: block;
                color: #0A0A0A;
                margin-top: 5px;
            }

        .hero-description {
            max-width: 460px;
            margin-top: 20px;
            font-size: 15px;
            font-weight: 600;
            line-height: 1.8;
        }

        .button {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            min-height: 48px;
            padding: 13px 22px;
            background: #0A0A0A;
            border: 2px solid #0A0A0A;
            color: #FFFFFF;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            transition: background .2s, color .2s;
            white-space: nowrap;
            cursor: pointer;
        }

            .button:hover {
                background: #FFFFFF;
                color: #0A0A0A;
            }

        /* Statistics */
        .stats-wrap {
            position: relative;
            margin-top: -38px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            border: 2px solid var(--shadow);
            box-shadow: 7px 7px 0 var(--shadow);
        }

        .stat {
            min-width: 0;
            min-height: 170px;
            padding: 23px;
            background: var(--surface);
            color: var(--text);
            border-right: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

            .stat.dark {
                background: #050505;
                color: #FFFFFF;
            }

            .stat.red {
                background: var(--red);
                color: #FFFFFF;
            }

        .stat-label {
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .stat-number {
            display: block;
            margin: 16px 0 9px;
            font-family: var(--cond);
            font-size: clamp(38px, 4.4vw, 65px);
            line-height: 1;
            overflow-wrap: anywhere;
        }

        .stat-description {
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }

        .stat.dark .stat-description {
            color: #C5C5C5;
        }

        .stat.red .stat-description {
            color: #FFE0DE;
        }

        /* Main content */
        main {
            padding: 58px 0 88px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 22px;
        }

            .section-heading h2 {
                font-size: clamp(35px, 4vw, 50px);
            }

                .section-heading h2 .ital {
                    color: var(--red);
                }

        .section-description {
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(300px, 1fr);
            gap: 24px;
            align-items: stretch;
        }

        .panel {
            min-width: 0;
            background: var(--surface);
            color: var(--text);
            border: 2px solid var(--shadow);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 24px;
            border-bottom: 1px solid var(--border);
        }

            .panel-header h3 {
                font-size: 27px;
            }

        .panel-body {
            padding: 24px;
        }

        .text-link {
            color: var(--red);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .text-link:hover {
                color: var(--red-dark);
                text-decoration: underline;
            }

        .empty-state {
            min-height: 265px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            border: 2px dashed var(--border);
            text-align: center;
        }

        .empty-icon {
            display: grid;
            place-items: center;
            width: 54px;
            height: 54px;
            margin-bottom: 18px;
            background: #FFF0EF;
            color: var(--red);
            font-size: 25px;
        }

        .empty-state h4 {
            font-size: 30px;
        }

        .empty-state p {
            max-width: 330px;
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        /* Import status */
        .source-card {
            padding: 19px;
            border: 1px solid var(--border);
            margin-bottom: 14px;
            background: var(--surface);
        }

            .source-card:last-child {
                margin-bottom: 0;
            }

        .source-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        .source-name {
            font-family: var(--cond);
            font-size: 27px;
            text-transform: uppercase;
        }

            .source-name .ital {
                color: var(--red);
            }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 5px 9px;
            background: #E8F7ED;
            color: #176B35;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

            .status::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: currentColor;
            }

            .status.pending {
                background: #FFF3D7;
                color: #855700;
            }

        .source-description {
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .progress-track {
            height: 7px;
            margin-top: 16px;
            background: var(--border);
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--red);
        }

        .progress-labels {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 8px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 800;
        }

        /* Import controls */
        .notice {
            margin-bottom: 18px;
            padding: 14px 16px;
            background: #FFF0EF;
            border-left: 4px solid var(--red);
            color: var(--red-dark);
            font-size: 13px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .import-box {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
        }

        .import-title {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .import-help {
            margin-top: 6px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .import-form {
            margin-top: 14px;
        }

        .file-input {
            display: block;
            width: 100%;
            margin-bottom: 12px;
            padding: 12px;
            border: 2px dashed var(--border);
            background: var(--input);
            color: var(--text);
            font: inherit;
            font-size: 16px;
            border-radius: 0;
        }

        .button.red {
            width: 100%;
            background: var(--red);
            border-color: var(--red);
            color: #FFFFFF;
        }

            .button.red:hover {
                background: #050505;
                border-color: #050505;
                color: #FFFFFF;
            }

        .button[disabled] {
            opacity: .6;
            cursor: wait;
            pointer-events: none;
        }

        /* Tables */
        .members {
            margin-top: 24px;
        }

        .table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        table.members-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .members-table th {
            text-align: left;
            padding: 14px 24px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .members-table td {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .members-table tr:last-child td {
            border-bottom: 0;
        }

        .members-table td.mute {
            color: var(--muted);
            font-weight: 500;
        }

        .members-table .who {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 150px;
        }

        .members-table .dot {
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            background: var(--nav);
            color: #FFFFFF;
            font-family: var(--cond);
            font-size: 16px;
        }

        .creator-photo {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            object-fit: cover;
            background: var(--surface-alt);
            border: 1px solid var(--border);
        }

        .rank {
            font-family: var(--cond);
            font-size: 20px;
            white-space: nowrap;
        }

        .vote-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            padding: 5px 10px;
            background: var(--surface-alt);
            border: 1px solid var(--border);
            font-weight: 800;
        }

        .source-list .source-card + .source-card {
            margin-top: 16px;
        }

        /* Quick actions */
        .quick-actions {
            margin-top: 58px;
        }

        .action-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .action-card {
            display: flex;
            min-height: 200px;
            flex-direction: column;
            justify-content: space-between;
            padding: 25px;
            background: #050505;
            color: #FFFFFF;
            transition: background .2s, transform .2s;
        }

            .action-card:nth-child(2) {
                background: var(--surface);
                color: var(--text);
                border: 2px solid var(--shadow);
            }

            .action-card:hover {
                background: var(--red);
                color: #FFFFFF;
                transform: translateY(-3px);
            }

            .action-card h3 {
                font-size: clamp(32px, 3vw, 43px);
            }

            .action-card p {
                max-width: 260px;
                margin-top: 12px;
                font-size: 12px;
                font-weight: 600;
                opacity: .8;
            }

        .action-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .09em;
        }

        .footer {
            padding: 23px 0 calc(23px + env(safe-area-inset-bottom));
            background: var(--nav);
            color: #BDBDBD;
            font-size: 11px;
            font-weight: 600;
        }

        .footer-inner {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        /* Light-mode refinements */
        html[data-theme="light"] .panel,
        html[data-theme="light"] .source-card,
        html[data-theme="light"] .action-card:nth-child(2) {
            background: #FFFFFF;
            color: #0A0A0A;
        }

        html[data-theme="light"] .stat.dark {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        html[data-theme="light"] .stat.red {
            background: var(--red);
            color: #FFFFFF;
        }

        html[data-theme="light"] .action-card:not(:nth-child(2)) {
            background: #0A0A0A;
            color: #FFFFFF;
        }

        html[data-theme="light"] .action-card:hover {
            background: var(--red);
            color: #FFFFFF;
        }

        /* Tablet */
        @@media (max-width: 1000px) {
            .topbar-inner {
                gap: 16px;
            }

            .nav {
                gap: 12px;
            }

                .nav a {
                    font-size: 11px;
                }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .overview-grid {
                grid-template-columns: 1fr;
            }

            .stat:nth-child(2n) {
                border-right: 0;
            }
        }

        /* Mobile */
        @@media (max-width: 680px) {
            .container {
                width: calc(100% - 32px);
            }

            .topbar-inner {
                min-height: 68px;
                flex-wrap: wrap;
                padding: 12px 0;
            }

            .logo {
                font-size: 25px;
            }

            .nav {
                order: 3;
                width: 100%;
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 4px;
            }

                .nav a {
                    flex-shrink: 0;
                    font-size: 12px;
                }

            .admin {
                gap: 7px;
            }

                .admin > span {
                    display: none;
                }

            .admin-avatar {
                width: 32px;
                height: 32px;
            }

            .theme-toggle {
                padding: 7px;
                font-size: 10px;
            }

            .logout {
                padding: 7px 9px;
                font-size: 10px;
            }

            .hero {
                padding: 42px 0 65px;
            }

            .hero-inner {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero h1 {
                font-size: clamp(49px, 12vw, 76px);
            }

            .hero-description {
                font-size: 13px;
            }

            .stats-wrap {
                margin-top: -30px;
            }

            .stats {
                box-shadow: 4px 4px 0 var(--shadow);
            }

            .stat {
                min-height: 140px;
                padding: 17px;
            }

            .stat-number {
                font-size: clamp(36px, 9vw, 52px);
                margin: 12px 0 7px;
            }

            .stat-label {
                font-size: 9px;
            }

            main {
                padding-top: 43px;
            }

            .panel-header,
            .panel-body {
                padding: 18px;
            }

                .panel-header h3 {
                    font-size: 23px;
                }

            .panel-header {
                align-items: flex-start;
            }

            .section-heading h2 {
                font-size: 38px;
            }

            .action-grid {
                grid-template-columns: 1fr;
            }

            .action-card {
                min-height: 165px;
            }

            .members-table thead {
                display: none;
            }

            .members-table,
            .members-table tbody,
            .members-table tr,
            .members-table td {
                display: block;
                width: 100%;
            }

                .members-table tr {
                    padding: 12px 18px;
                    border-bottom: 1px solid var(--border);
                }

                .members-table td {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 16px;
                    padding: 7px 0;
                    border-bottom: 0;
                    text-align: right;
                }

                    .members-table td::before {
                        content: attr(data-label);
                        flex-shrink: 0;
                        color: var(--muted);
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: .08em;
                        text-transform: uppercase;
                        text-align: left;
                    }

                .members-table .who {
                    justify-content: flex-end;
                    text-align: right;
                }

                    .members-table .who .creator-name {
                        overflow-wrap: anywhere;
                    }
        }

        @@media (max-width: 380px) {
            .container {
                width: calc(100% - 24px);
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .stat {
                min-height: 120px;
                border-right: 0;
            }

            .stat-number {
                font-size: 50px;
            }

            .section-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .theme-toggle span:last-child {
                display: none;
            }
        }

        @@media (hover: none) {
            .action-card:hover {
                transform: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>
    <nav class="topbar">
        <div class="container topbar-inner">
            <a asp-controller="Home" asp-action="Dashboard" class="logo">
                Creator<span>Hub</span>
            </a>

            <div class="nav" aria-label="Admin navigation">
                <a asp-controller="Home" asp-action="Dashboard" class="active">Dashboard</a>
                <a asp-controller="Creators" asp-action="Index">Creators</a>
                <a class="soon" title="Coming soon">Platforms</a>
                <a class="soon" title="Coming soon">Imports</a>
            </div>

            <div class="admin">
                <span>@adminName</span>
                <div class="admin-avatar" aria-label="Administrator">@initial</div>

                <button type="button"
                        class="theme-toggle"
                        id="themeToggle"
                        aria-label="Switch theme">
                    <span id="themeIcon" aria-hidden="true">☀️</span>
                    <span id="themeLabel">Light mode</span>
                </button>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">
                    <button type="submit" class="logout">Log out</button>
                </form>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container hero-inner">
            <div>
                <div class="eyebrow">Creator management system</div>
                <h1 class="cond">Creator <span class="ital">Hub dashboard</span></h1>
                <p class="hero-description">
                    One place to manage creators, monitor profile imports,
                    review voting performance, and keep your members and
                    connected platforms organised.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="button">
                View site <span aria-hidden="true">↗</span>
            </a>
        </div>
    </header>

    <div class="container stats-wrap">
        <section class="stats" aria-label="Dashboard statistics">
            <article class="stat dark">
                <span class="stat-label">Total creators</span>
                <strong class="stat-number">@Model.TotalCreators.ToString("N0")</strong>
                <p class="stat-description">Creator records in the system</p>
            </article>

            <article class="stat red">
                <span class="stat-label">Profile URLs</span>
                <strong class="stat-number">@Model.TotalProfileUrls.ToString("N0")</strong>
                <p class="stat-description">Collected across all platforms</p>
            </article>

            <article class="stat">
                <span class="stat-label">Members</span>
                <strong class="stat-number">@Model.TotalMembers.ToString("N0")</strong>
                <p class="stat-description">Registered member accounts</p>
            </article>

            <article class="stat">
                <span class="stat-label">Platforms</span>
                <strong class="stat-number">@Model.TotalPlatforms.ToString("N0")</strong>
                <p class="stat-description">Configured sources</p>
            </article>

            <article class="stat dark">
                <span class="stat-label">Total votes</span>
                <strong class="stat-number">@Model.TotalVotes.ToString("N0")</strong>
                <p class="stat-description">Recorded creator selections</p>
            </article>

            <article class="stat">
                <span class="stat-label">Matchups</span>
                <strong class="stat-number">@Model.TotalMatchups.ToString("N0")</strong>
                <p class="stat-description">Distinct creator pairs voted on</p>
            </article>
        </section>
    </div>

    <main>
        <div class="container">

            @if (TempData["ImportMessage"] is string importMessage)
            {
                <div class="notice" role="status">@importMessage</div>
            }

            <!-- Creator overview and import centre -->
            <section class="overview-grid">
                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h3 class="cond">Creators <span class="ital">overview</span></h3>
                            <p class="section-description">
                                Creator records processed and saved into CreatorHub.
                            </p>
                        </div>
                        <a asp-controller="Creators"
                           asp-action="Index"
                           class="text-link">View all ↗</a>
                    </div>

                    <div class="panel-body">
                        @if (Model.TotalCreators > 0)
                        {
                            <div class="source-card">
                                <div class="source-top">
                                    <strong>Creator records available</strong>
                                    <span class="status">Available</span>
                                </div>
                                <p class="source-description">
                                    There are @Model.TotalCreators.ToString("N0") creator records,
                                    of which @Model.ActiveCreators.ToString("N0") are active.
                                </p>
                            </div>

                            <div class="source-card">
                                <div class="source-top">
                                    <strong>Profile processing</strong>
                                    <span class="status pending">
                                        @((Model.TotalProfileUrls - Model.ProcessedProfileUrls).ToString("N0")) pending
                                    </span>
                                </div>
                                <p class="source-description">
                                    @Model.ProcessedProfileUrls.ToString("N0") of
                                    @Model.TotalProfileUrls.ToString("N0") collected profile URLs processed.
                                </p>

                                <div class="progress-track">
                                    <div class="progress-fill"
                                         style="width:@(Model.TotalProfileUrls > 0 ? Math.Clamp((int)Math.Round(Model.ProcessedProfileUrls * 100.0 / Model.TotalProfileUrls), 0, 100) : 0)%">
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="empty-icon" aria-hidden="true">＋</div>
                                <h4 class="cond">No creators yet</h4>
                                <p>
                                    Profile URLs may have been collected.
                                    Creator records will appear here after profile processing runs.
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <h3 class="cond">Import <span class="ital">status</span></h3>
                            <p class="section-description">Profile processing by source</p>
                        </div>
                    </div>

                    <div class="panel-body source-list">
                        @if (Model.Sources.Count == 0)
                        {
                            <p class="section-description">
                                No profile URLs have been collected yet.
                            </p>
                        }

                        @foreach (var src in Model.Sources)
                        {
                            <div class="source-card">
                                <div class="source-top">
                                    <span class="source-name">
                                        <span class="ital">@src.Source</span>
                                    </span>

                                    @if (src.Percent >= 100)
                                    {
                                        <span class="status">Complete</span>
                                    }
                                    else
                                    {
                                        <span class="status pending">Pending</span>
                                    }
                                </div>

                                <p class="source-description">
                                    @src.Processed.ToString("N0") processed ·
                                    @((src.Total - src.Processed).ToString("N0")) pending
                                </p>

                                <div class="progress-track">
                                    <div class="progress-fill" style="width:@(src.Percent)%"></div>
                                </div>

                                <div class="progress-labels">
                                    <span>@src.Total.ToString("N0") URLs collected</span>
                                    <span>@src.Percent%</span>
                                </div>
                            </div>
                        }

                        <div class="import-box">
                            <div class="import-title">Import Frivol profiles</div>
                            <p class="import-help">
                                Fetches the next 5 unprocessed Frivol profiles and saves them as creators.
                            </p>

                            <form asp-controller="Home"
                                  asp-action="ImportFrivol"
                                  method="post"
                                  class="import-form"
                                  id="import-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="batchSize" value="5" />

                                <button type="submit" class="button red" id="import-button">
                                    Import 5 Frivol profiles <span aria-hidden="true">↓</span>
                                </button>
                            </form>
                        </div>

                        <div class="import-box">
                            <div class="import-title">Attach MDH pictures</div>
                            <p class="import-help">
                                Upload <strong>mdh_avatars.csv</strong>. Each matching MDH profile
                                gets the picture shown on its search card.
                            </p>

                            <form asp-controller="Home"
                                  asp-action="ImportMdhImages"
                                  method="post"
                                  enctype="multipart/form-data"
                                  class="import-form"
                                  id="mdh-form">
                                @Html.AntiForgeryToken()

                                <input type="file"
                                       name="file"
                                       id="mdh-file"
                                       accept=".csv,text/csv"
                                       class="file-input"
                                       required />

                                <button type="submit" class="button red" id="mdh-button">
                                    Attach pictures <span aria-hidden="true">↑</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Voting leaderboard -->
            <section class="panel members" id="admin-leaderboard">
                <div class="panel-header">
                    <div>
                        <h3 class="cond">Voting <span class="ital">leaderboard</span></h3>
                        <p class="section-description">
                            Top 5 creators ranked by recorded winning votes.
                        </p>
                    </div>

                    <a asp-controller="Voting"
                       asp-action="Leaderboard"
                       class="text-link">Full leaderboard ↗</a>
                </div>

                @if (Model.TopCreators.Count == 0)
                {
                    <div class="panel-body">
                        <div class="empty-state">
                            <div class="empty-icon" aria-hidden="true">↗</div>
                            <h4 class="cond">No votes yet</h4>
                            <p>
                                The rankings will appear here after votes have been recorded.
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="members-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Creator</th>
                                    <th>Winning votes</th>
                                    <th>Creator directory</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var creator in Model.TopCreators)
                                {
                                    <tr>
                                        <td data-label="Rank">
                                            <span class="rank">
                                                @if (creator.Rank == 1)
                                                {
                                                    @:🥇 #1
                                                }
                                                else if (creator.Rank == 2)
                                                {
                                                    @:🥈 #2
                                                }
                                                else if (creator.Rank == 3)
                                                {
                                                    @:🥉 #3
                                                }
                                                else
                                                {
                                                    @:#@creator.Rank
                                                }
                                            </span>
                                        </td>

                                        <td data-label="Creator">
                                            <div class="who">
                                                @if (!string.IsNullOrWhiteSpace(creator.ProfileImageUrl))
                                                {
                                                    <img class="creator-photo"
                                                         src="@creator.ProfileImageUrl"
                                                         alt=""
                                                         loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="dot">
                                                        @(string.IsNullOrWhiteSpace(creator.DisplayName)
                                                                                                    ? "?"
                                                                                                    : creator.DisplayName.Substring(0, 1).ToUpperInvariant())
                                        </span>
                                                                                }

                                                <span class="creator-name">@creator.DisplayName</span>
                                            </div>
                                        </td>

                                        <td data-label="Winning votes">
                                            <span class="vote-count">
                                                @creator.VoteCount.ToString("N0")
                                            </span>
                                        </td>

                                        <td data-label="Directory">
                                            <a asp-controller="Creators"
                                               asp-action="Index"
                                               class="text-link">Browse creators ↗</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- Recent members -->
            <section class="panel members">
                <div class="panel-header">
                    <div>
                        <h3 class="cond">Recent <span class="ital">members</span></h3>
                        <p class="section-description">The latest people who signed up.</p>
                    </div>
                    <span class="text-link">@Model.TotalMembers.ToString("N0") total</span>
                </div>

                @if (Model.RecentMembers.Count == 0)
                {
                    <div class="panel-body">
                        <p class="section-description">Nobody has signed up yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="members-table">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Email</th>
                                    <th>Region</th>
                                    <th>Gender</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.RecentMembers)
                                {
                                    <tr>
                                        <td data-label="Member">
                                            <div class="who">
                                                <span class="dot">
                                                    @(string.IsNullOrWhiteSpace(m.Name)
                                                                                                ? "?"
                                                                                                : m.Name.Substring(0, 1).ToUpperInvariant())
                                        </span>
                                        <span class="creator-name">@m.Name</span>
                                    </div>
                                </td>
                                <td class="mute" data-label="Email">@m.Email</td>
                                <td data-label="Region">@m.Region</td>
                                <td data-label="Gender">@m.Gender</td>
                                <td class="mute" data-label="Joined">
                                    @m.JoinedAt.ToString("dd MMM yyyy")
                                </td>
                            </tr>
                                                        }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- Quick actions -->
            <section class="quick-actions">
                <div class="section-heading">
                    <div>
                        <h2 class="cond">Quick <span class="ital">actions</span></h2>
                        <p class="section-description">
                            Jump straight to the section you need.
                        </p>
                    </div>
                </div>

                <div class="action-grid">
                    <a asp-controller="Creators"
                       asp-action="Index"
                       class="action-card">
                        <div>
                            <h3 class="cond">Creators</h3>
                            <p>View and manage creator records and profile details.</p>
                        </div>
                        <div class="action-footer">
                            <span>OPEN CREATORS</span><span>↗</span>
                        </div>
                    </a>

                    <a asp-controller="Voting"
                       asp-action="Leaderboard"
                       class="action-card">
                        <div>
                            <h3 class="cond">Leaderboard</h3>
                            <p>Review creator rankings and voting performance.</p>
                        </div>
                        <div class="action-footer">
                            <span>VIEW RANKINGS</span><span>↗</span>
                        </div>
                    </a>

                    <a class="action-card soon" aria-disabled="true">
                        <div>
                            <h3 class="cond">Platforms</h3>
                            <p>Manage connected platforms and their collection settings.</p>
                        </div>
                        <div class="action-footer">
                            <span>COMING SOON</span><span>·</span>
                        </div>
                    </a>
                </div>
            </section>
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>© @DateTime.UtcNow.Year CreatorHub</span>
            <span>Creator management · Voting · Platform imports</span>
        </div>
    </footer>

    <script>
        // Theme switcher: shared preference across CreatorHub pages.
        (function () {
            const root = document.documentElement;
            const toggle = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");
            const label = document.getElementById("themeLabel");

            if (!toggle || !icon || !label) return;

            function applyTheme(theme) {
                const isDark = theme === "dark";

                root.dataset.theme = theme;
                icon.textContent = isDark ? "☀️" : "🌙";
                label.textContent = isDark ? "Light mode" : "Dark mode";
                toggle.setAttribute(
                    "aria-label",
                    isDark ? "Switch to light mode" : "Switch to dark mode"
                );

                try {
                    localStorage.setItem("creatorhub-theme", theme);
                } catch {
                    // Theme still applies to the current page.
                }
            }

            toggle.addEventListener("click", function () {
                applyTheme(
                    root.dataset.theme === "dark" ? "light" : "dark"
                );
            });

            applyTheme(root.dataset.theme || "dark");
        })();

        // Prevent duplicate submissions while imports are running.
        (function () {
            [
                ["import-form", "import-button", "Importing, please wait..."],
                ["mdh-form", "mdh-button", "Uploading, please wait..."]
            ].forEach(function (ids) {
                const form = document.getElementById(ids[0]);
                const button = document.getElementById(ids[1]);

                if (!form || !button) return;

                form.addEventListener("submit", function () {
                    if (!form.checkValidity()) return;

                    button.disabled = true;
                    button.textContent = ids[2];
                });
            });
        })();
    </script>
</body>
</html>
